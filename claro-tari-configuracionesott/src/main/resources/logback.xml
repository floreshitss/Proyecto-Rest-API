<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="file" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <File>/logs-apps/claro-tari-configuracionesott/claro-tari-configuracionesott.log</File>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [${weblogic.Name:-WebLogic}] [traceId=%X{traceId:-N/A}] [%-5level] [%logger{36}:%line] %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>/logs-apps/claro-tari-configuracionesott/claro-tari-configuracionesott.%d{yyyy-MM-dd-HH}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
    </appender>
    <appender name="Console-Appender" class="ch.qos.logback.core.ConsoleAppender">
        <layout>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [traceId=%X{traceId:-N/A}] [%-5level] %msg%n</pattern>
        </layout>
    </appender>
    <root level="INFO">
        <appender-ref ref="file"/>
        <appender-ref ref="Console-Appender"/>
    </root>
</configuration>
